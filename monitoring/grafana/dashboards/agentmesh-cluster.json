    {
      "type": "table",
      "title": "Stan agentów / maszyn",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "mesh_machine_up",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "mesh_machine_heartbeat_age_seconds",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "mesh_machine_cpu_percent",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "mesh_machine_ram_percent",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "mesh_machine_replica_health",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "machine" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "cluster": true,
              "cluster 1": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "machine": "ID",
              "name": "Nazwa",
              "role": "Rola",
              "host": "Host",
              "status": "Status",
              "Value #A": "Online",
              "Value #B": "HB age s",
              "Value #C": "CPU %",
              "Value #D": "RAM %",
              "Value #E": "Replica %"
            }
          }
        }
      ],
      "options": { "showHeader": true, "sortBy": [{ "displayName": "ID", "desc": false }] },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Online" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "OFF", "color": "red" },
                      "1": { "text": "ON", "color": "green" }
                    }
                  }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HB age s" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 30 },
                    { "color": "red", "value": 45 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      }
    },
