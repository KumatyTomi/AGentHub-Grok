# =============================================================================
# AgentMesh LOCAL cluster — skopiuj do cluster.env i dostosuj
# Ten plik NIE idzie do chmury. Trzymaj na pendrive / share LAN.
# =============================================================================

# --- sieć LAN (prywatna, bez internetu OK) ---
CLUSTER_SUBNET=10.20.0.0/24
CLUSTER_GATEWAY=10.20.0.1
CLUSTER_VLAN=20
CLUSTER_DNS=10.20.0.1

# IP stacji (ustaw na każdej maszynie statycznie lub rezerwacja DHCP)
ALPHA_IP=10.20.0.10
BETA_IP=10.20.0.20
GAMMA_IP=10.20.0.30

# --- porty (tylko LAN / localhost) ---
CORE_PORT=8765
UI_PORT=8080
OLLAMA_PORT=11434

# --- ścieżki magazynu (osobny SSD zalecany) ---
MESH_ROOT=E:\AgentMesh
ALPHA_WORKSPACE=E:\AgentMesh\alpha\workspace
BETA_DATA=E:\AgentMesh\beta
GAMMA_MODELS=E:\AgentMesh\gamma\ollama

# --- klaster ---
CLUSTER_NAME=MESH-LOCAL-01
# PIN operatora ustawisz ręcznie w kreatorze / core (nie trzymaj w plain text w prod)

# --- Ollama (GAMMA) ---
# Model startowy — zmień na to, co mieści się w VRAM
OLLAMA_MODEL=llama3.2
# Nasłuch tylko w LAN (0.0.0.0) — firewall ograniczy do subnetu
OLLAMA_HOST=0.0.0.0:11434

# --- Codex (ALPHA) ---
# full-local: użyj Ollamy na GAMMA (air-gap)
# cloud: wymaga loginu ChatGPT / API (wtedy wychodzi w internet)
CODEX_MODE=local
CODEX_LOCAL_PROVIDER=ollama
# Codex wskazuje na Ollamę przez OpenAI-compatible base URL:
CODEX_OLLAMA_BASE=http://10.20.0.30:11434/v1

# --- Node / narzędzia ---
NODE_MAJOR=22
